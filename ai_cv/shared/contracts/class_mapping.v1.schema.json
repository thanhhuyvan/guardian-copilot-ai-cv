{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-copilot.local/schemas/class_mapping.v1.schema.json",
  "title": "GuardianCoPilot Object Class Mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "mapping", "notes"],
  "properties": {
    "schema_version": { "const": "class_mapping.v1" },
    "source": { "const": "dataset.target_class" },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicle", "walker", "bike"],
      "properties": {
        "vehicle": { "const": "vehicle" },
        "walker": { "const": "pedestrian" },
        "bike": { "const": "two_wheeler" }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}

