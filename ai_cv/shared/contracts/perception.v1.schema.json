{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guardian-copilot.local/schemas/perception.v1.schema.json",
  "title": "GuardianCoPilot Perception Frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trip_id",
    "frame_id",
    "timestamp",
    "status",
    "objects",
    "min_ttc_sec",
    "risk_level",
    "perception_quality",
    "latency_ms"
  ],
  "properties": {
    "schema_version": { "const": "perception.v1" },
    "trip_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "number", "minimum": 0 },
    "status": { "enum": ["valid", "degraded", "unknown"] },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/tracked_object" }
    },
    "min_ttc_sec": {
      "description": "Null represents no finite/reliable TTC; CSV serialization uses inf.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "risk_level": {
      "enum": ["SAFE", "WARNING", "DANGER", "CRITICAL", "UNKNOWN"]
    },
    "perception_quality": { "type": "number", "minimum": 0, "maximum": 1 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "degraded_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "tracked_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id",
        "object_type",
        "bbox_xyxy",
        "detection_confidence",
        "distance_m",
        "closing_speed_mps",
        "ttc_sec",
        "in_collision_corridor",
        "ttc_quality"
      ],
      "properties": {
        "track_id": { "type": "integer", "minimum": 0 },
        "object_type": {
          "enum": ["car", "truck", "bus", "motorcycle", "bicycle", "pedestrian", "obstacle", "unknown"]
        },
        "bbox_xyxy": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false
        },
        "detection_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "distance_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "closing_speed_mps": { "type": ["number", "null"] },
        "ttc_sec": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "in_collision_corridor": { "type": "boolean" },
        "ttc_quality": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

